{
  "name": "ycoders-editor-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "test:vercel-output": "node scripts/verify-vercel-function-runtime.mjs",
    "emulators:test": "firebase emulators:exec --project demo-ycoders-editor-v2 --only auth,firestore,storage \"npm run test:emulator\"",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "idb": "^8.0.4",
    "json-canonicalize": "^3.0.1",
    "lucide-react": "latest",
    "monaco-editor": "^0.57.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vercel/node": "^31.0.0",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fake-indexeddb": "^6.2.8",
    "firebase-tools": "^15.36.0",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
