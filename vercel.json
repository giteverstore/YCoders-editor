{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v2/gateway/:path*", "destination": "/api/internal-v2-gateway/dispatch?gatewayPath=$1" },
    { "source": "/api/v2/:path*", "destination": "/api/internal-v2-admin/dispatch?adminPath=$1" },
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
