# Public Firebase web-app configuration (not an authorization secret)
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
# Optional client Auth emulator URL for local UI testing:
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Deliberate UI/API availability gate. Firebase web configuration alone never
# enables cloud operations. Development additionally requires a demo-* project
# and the loopback Auth emulator URL above.
VITE_ENABLE_CLOUD_DRAFTS=false
# Preview stays disabled unless an isolated preview backend is explicitly approved.
VITE_ENABLE_PREVIEW_CLOUD_DRAFTS=false

# Server-only project selection. Never prefix server credentials with VITE_.
FIREBASE_ADMIN_PROJECT_ID=your-project-id

# Learner-gateway service trust. Production remains unconfigured until the
# approved Vercel OIDC -> Google WIF identity verifier is provisioned.
V2_GATEWAY_SERVICE_AUTH_MODE=disabled
V2_GATEWAY_TRUST_ENVIRONMENT=emulator
# Test-only Ed25519 public key. Accepted only outside production with demo-* projects.
# V2_GATEWAY_TEST_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
V2_GATEWAY_GOOGLE_TOKEN_AUDIENCE=
V2_GATEWAY_SERVICE_ACCOUNT_EMAIL=

# Required together for local backend development and integration tests.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Production Vercel should use Workload Identity Federation / ADC.
# GOOGLE_APPLICATION_CREDENTIALS must never point to a committed service-account file.

# Candidate Production Editor profile. These values are code contracts, not
# deployment approval; verify the live Vercel project mapping before release.
# FIREBASE_BACKEND_AUTH_MODE=production-wif
# FIREBASE_ADMIN_PROJECT_ID=mi-tutora-pro
# FIREBASE_STORAGE_BUCKET=mi-tutora-pro-admin-content
# EDITOR_FIREBASE_WIF_AUDIENCE=//iam.googleapis.com/projects/196429461457/locations/global/workloadIdentityPools/ai-tutor-vercel/providers/vercel-admin-production
# EDITOR_FIREBASE_SERVICE_ACCOUNT_EMAIL=ycoders-admin-runtime@mi-tutora-pro.iam.gserviceaccount.com
